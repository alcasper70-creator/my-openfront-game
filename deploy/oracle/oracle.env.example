# Public domain pointing to the Oracle VM's public IPv4 address.
GAME_DOMAIN=game.example.com

# This configuration deliberately uses dev mode so anonymous multiplayer can
# run without the separate production OpenFront account/API service.
GAME_ENV=dev
DOMAIN=game.example.com
SITE_HOST=game.example.com
GAME_HOST=game.example.com
INSTANCE_LETTER=a
NUM_WORKERS=2
GIT_COMMIT=oracle-free

# Cloudflare's documented development test key. Replace it with your own
# Turnstile site key before making the game public.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional in dev mode. Required when you later add a compatible production
# API service.
API_KEY=
